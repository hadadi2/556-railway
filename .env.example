# مفاتيح منصة سِلك — Silk platform keys.
# انسخ هذا الملف إلى .env واملأ القيم.  Copy this file to .env and fill values.
# (.env متجاهَل في git — لا يُرفع.  .env is gitignored — never committed.)

# ── مصادر البيانات · DATA SOURCES ─────────────────────────────────────────────

# UN Comtrade: اختياري. بدونه يعمل وضع المعاينة (محدود). بمفتاح مجاني يرتفع الحد
# إلى ~500 طلب/يوم. سجّل في: https://comtradedeveloper.un.org
COMTRADE_API_KEY=

# World Bank: لا يحتاج مفتاحًا إطلاقًا (مفتوح).  No key needed (open API).

# ── حراسة الموجة ٠ · WAVE-0 GUARDS (اضبطها كلها في الإنتاج) ───────────────────

# مصادقة /analyze: عند ضبطه يتطلب كل طلب ترويسة X-API-Key مطابقة وإلا 401.
# غير مضبوط = وضع تطوير مفتوح. Auth for POST /analyze (401 without header).
SILK_API_KEY=

# WP-7: سلطة تجاوز بوابة الجودة (?override=1 على تصدير العميل) — ترويسة
# X-Owner-Key يجب أن تطابق هذه القيمة؛ مفتاح API العادي وحده لا يكفي (403).
# غير مضبوط = لا تجاوز ممكن إطلاقاً. Owner-only quality-gate override key.
SILK_OWNER_KEY=

# سقف الطبقات المدفوعة اليومي: عدد تفعيلات (localprice/volza/explee/ai) المسموح
# يوميًا؛ التجاوز = 429. غير مضبوط = لا سقف (تطوير). Daily paid-layer cap (429).
# ملاحظة أمنية (M-2): عند تعذّر قراءة العدّاد (قرص/قفل/تلف) تُرفض الطبقات
# المدفوعة (fail-closed) — الرفض أأمن من تجاوز صامت للسقف.
# دلالة عدم الاسترداد (البند #10، تدقيق v2): الحجز يقع **قبل** النداء ولا يُردّ
# إن فشل النداء أو عاد بلا نتيجة (تعذّر قراءة صورة الاستقبال، انقطاع مزوّد) —
# قرارٌ مقصود (fail-closed: لا نُنقِص محاسبةً لنداءٍ جرت محاولته). فبانقطاعٍ
# متكرّر قد يُستنفَد العدّاد بلا نتائج ناجحة؛ هذا السلوك المتوقَّع لا خلل.
# No-refund semantics: a unit is reserved before the call and NOT refunded on
# failure/empty result (fail-closed) — a provider outage can exhaust the cap
# with zero successful reads; this is intended, not a bug.
SILK_PAID_DAILY_CAP=

# حدّ الإنفاق الدولاري اليومي (H6، تدقيق 2026-07-15): SILK_PAID_DAILY_CAP يحدّ
# *عدد* التفعيلات؛ هذا يحدّ *الدولارات* الفعلية المُقدَّرة (تشغيلة /research قد
# تكلّف ~$7 وهي تفعيلة واحدة). حجز ذرّي (BEGIN IMMEDIATE): يُحجَز التقدير قبل
# بدء /research ويُرفض البدء بـ429 حين (المُنفَق + المتوقَّع) > السقف، فلا تمرّ
# تشغيلتان متزامنتان قرب الحدّ معاً. الإنفاق الفعلي (رموز كل نداءات كلود بما فيها
# محاولات تصعيد الكاتب ودورات المراجع) يُصالِح الحجز بعد التشغيلة. غير مضبوط =>
# لا حدّ دولاري. عدّاد التفعيلات الذرّي يبقى الحارس المالي fail-closed المستقل.
SILK_PAID_DAILY_USD_CAP=
# التكلفة المتوقَّعة لتشغيلة /research (للبوابة المسبقة أعلاه) — الافتراضي 3.0$.
SILK_RESEARCH_EXPECTED_USD=

# ── ذكاء ما قبل التشغيل (Wave 1) · PRE-RUN INTELLIGENCE ───────────────────────
# كلّها أعلامٌ افتراضها «السلوك كاليوم» (مُطفأة) — فعّلها في الإنتاج بعد المراجعة.
# All default to today's behavior (off); enable in production after review.
#
# مُصنِّف HS العام: حين يفشل المُحلِّل الحتمي أو تضعف ثقته، نداءُ كلود واحدٌ
# مقيس (count + dollar، ضمن السقف اليومي المشترك) يقترح HS6 من معرفته الكاملة
# بنظام HS — مصادَقٌ ببوابة تحقّق حتمية، اقتراحٌ يؤكّده المستخدم، لا اختلاق.
# يحتاج ANTHROPIC_API_KEY. **فشل-آمن: مفعّل افتراضياً** (اللائحة ٤٢) — اتركه
# فارغاً للسلوك الافتراضي؛ اضبطه على 0 فقط لتعطيله عمداً (يعود عندها لسقف
# جدول البحث الجزئي القديم). HS-classifier (metered, grounded, ON by default).
SILK_HS_CLASSIFIER=
# التكلفة الدولارية المتوقَّعة لنداء التصنيف الواحد (للمصالحة) — الافتراضي 0.02$.
SILK_HS_CLASSIFY_EXPECTED_USD=
# عتبة ثقة المُحلِّل الحتمي التي دونها نستدعي كلود — الافتراضي 0.7 (كـresolve_all).
SILK_HS_MIN_CONFIDENCE=
# عدد مرشّحي المرجع للإرساء/المنتقي اليدوي — الافتراضي 8.
SILK_HS_CLASSIFIER_CANDIDATES=
#
# حسمُ الرمز بالسمة الرقمية (اللائحة ٦٥ — «قِسِ الرقمَ قبل أن تسأل عنه»):
# حين تتمايز بنودُ الترويسة بعتبةٍ رقمية (نسبة دهن/سعة/وزن/بريكس)، يُقاس
# الرقمُ قبل عرض أيّ حوار: سماتُ بطاقة العبوة من نداء الرؤية القائم (صفر
# تكلفة إضافية) ثم استعلامُ بحثٍ واحد (SEARCH_API_KEY) برابطٍ قابلٍ للاستشهاد.
# بلا رقمٍ يقع في نطاقٍ **وحيد** لا يُحسَم رمزٌ أبداً — يُعرَض الحوار (لا
# اختلاق). **مُطفأ افتراضياً** (أمر المُشرِف D1 / اللائحة ٧٠: صمّام الميزة
# الجديدة يُشحَن مطفأً، وتفعيله قرار مالك منفصل مشروط بإغلاق G8 — ثلاث
# تشغيلات حية مسجَّلة). اضبطه على 1 للتفعيل. (كان هذا السطر يقول «مفعّل
# افتراضياً» بينما الشيفرة مطفأة — انجراف توثيقي أُصلح 2026-08-17.)
# Numeric-attribute HS auto-resolution (image label → web → dialog).
# OFF by default (supervisor order D1); enabling is a separate owner decision.
SILK_HS_ATTRIBUTE_RESOLVE=
# نافذةُ الجوار (محارف) بين اسم البُعد والرقم في نصّ نتيجة البحث — الافتراضي 60.
SILK_HS_ATTR_PROXIMITY=
# عدد نتائج البحث المفحوصة في استعلام السمة الواحد — الافتراضي 5.
SILK_HS_ATTR_WEB_RESULTS=
# سقفُ السمات الرقمية المقروءة من بطاقة العبوة في نداء الرؤية — الافتراضي 12.
SILK_INTAKE_MAX_ATTRIBUTES=
#
# البوّابة الصلبة: =1 يرفض /research بـ422 ما دام رمز HS فارغًا (قبل أيّ حجز/
# إنفاق) — يُغلق حادثة الفيتوتشيني (دراسةٌ مدفوعةٌ برمز مجهول). Hard hs6 gate.
#
# **[متروك عملياً منذ 2026-08-30]** خطُّ التصنيف الواحد يرفض التصنيفَ غير
# المحسوم على كل مسارٍ ينفق سواءٌ ضُبِط هذا أم لا («لا تقبل تصنيفاً غير محسومٍ
# بصمت»). يبقى الاسمُ للتوافق ولا أثرَ لضبطه أو تركه.
SILK_REQUIRE_HS6=
#
# استشارة بلد المنشأ: =1 يُحذّر (422 حتى موافقة صريحة producer_ack) حين السوق
# المستهدفة من أكبر مصدّري هذا الرمز عالميًا (بيانات كومتريد، صفر نداء مدفوع).
# Producer-country advisory (top-exporter warning; consent required).
SILK_PRODUCER_ADVISORY=
# عتبة «من أكبر المصدّرين» (أكبر N) — الافتراضي 5. Top-N exporters threshold.
SILK_PRODUCER_ADVISORY_TOPN=

# البند أ٢ — معقولية بلد المورّد: =1 يُحذّر (422 حتى a2_ack) حين لا يظهر كبار
# موردي السوق لهذا الرمز بين أكبر مصدّري الرمز عالميًا (تفكّكٌ شبه تامّ = الرمز
# قد يصف عائلةً مختلفة). كومتريد فقط، صفر نداء مدفوع. مطفأ افتراضيًا.
# A2 supplier-country plausibility advisory (consent required); off by default.
SILK_A2_PLAUSIBILITY=
# أقصى تداخلٍ (0..1) يُطلق التحذير — الافتراضي 0.0 (تفكّكٌ تامّ فقط).
SILK_A2_MAX_OVERLAP=
# الحدّ الأدنى لعدد الموردين/المصدّرين لكلا الطرفين قبل الحكم — الافتراضي 3.
SILK_A2_MIN_ENTRIES=
# أعلى M مورّدٍ للسوق يُفحَصون — الافتراضي 5. Top-M market suppliers checked.
SILK_A2_SUPPLIERS_TOPM=

# حزمة الإغلاق — البند ٣: /diagnostics يُطلق نداءات مدفوعة حيّة (Serper/Maps/
# Claude) بمفاتيح الخادم، فيحجز وحدة واحدة من SILK_PAID_DAILY_CAP قبل الفحص حين
# السقف مضبوط (بلا سقف: لا حجز، سلوك افتراضي). اضبط =1 لإعفاء التشخيص من السقف
# (تشخيص متكرر أثناء تصحيح النشر بلا استهلاك الرصيد). غير مضبوط => لا إعفاء.
SILK_DIAG_EXEMPT=

# حزمة الإغلاق — البند ٢: عتبة نبضة حاصد التشغيلات اليتيمة بالدقائق (الافتراضي
# ٣٠، أطول من أطول تشغيلة /research مشروعة). صفّ 'running' لم يُلمَس (updated_at)
# منذ هذه المدة = عمليته ماتت (إعادة نشر/SIGKILL) فيُوسَم 'failed' ويُصالَح حجزه
# الدولاري إلى الفعلي-حتى-الآن — عند الإقلاع ودورياً.
SILK_ORPHAN_STALE_MINUTES=

# تحديد المعدّل (M-1): أقصى عدد طلبات لكل هوية (X-API-Key أو IP) خلال النافذة؛
# التجاوز = 429. الافتراضي 120 طلباً/60 ثانية؛ 0 يعطّل الحدّ. تحديد بالذاكرة
# (أداة داخلية، بلا Redis). Simple in-memory rate limit (per key/IP).
# SILK_RATE_LIMIT=120
# SILK_RATE_WINDOW=60

# ملف عدّاد الاستهلاك (اختياري) — مستقل عن silk.db. Usage-counter DB path.
# SILK_USAGE_DB=data/usage.db

# القرص الدائم (Railway volume): متغير واحد يوجّه **كل** المخازن للقرص —
# قاعدة التحليلات silk.db + مخزن الحقائق silk_store.db + عدّاد usage.db +
# ذاكرة الطلبات cache/ — فتنجو كلها من إعادة النشر ولا يُدفع ثمن الجلب مرتين.
# One var points EVERY store at the persistent volume (survives redeploys).
# المتغيرات الصريحة أدناه تفوز عليه فرادى — explicit per-store vars win over it.
# SILK_DATA_DIR=/data

# مصيدة إقلاع (LESSONS.md البند ٤): اضبطها =1 على الإنتاج مع SILK_DATA_DIR —
# فترفض الخدمة الإقلاع بصوت عالٍ إن غاب توجيه تخزين دائم (SILK_DATA_DIR/SILK_DB)
# بدل الكتابة الصامتة على قرص فانٍ يُمحى عند إعادة النشر فتُفقَد التحليلات.
# مطفأة افتراضياً (وضع تطوير مفتوح). Fail-fast if no persistent store is routed.
# تقوية (بلاغ مالك حيّ): لا تكتفي بأن المتغيّر مضبوط — تتحقّق أن المسار وحدة
# تخزين مركَّبة فعلًا (os.path.ismount) وقابل للكتابة، وإلا ترفض الإقلاع (كان
# SILK_DATA_DIR=/data مضبوطًا بلا Volume مركَّب فتُمحى الدراسات المدفوعة بصمت).
# SILK_REQUIRE_PERSISTENT_DATA_DIR=1

# مخرج صريح لمضيفٍ قرصه الجذري دائم أصلًا (لا وحدة تخزين منفصلة): =1 يتخطّى فحص
# «مركَّب فعلًا» أعلاه مع إبقاء فحص القابلية للكتابة. قرار مشغّل صريح لا صمت.
# Escape hatch when the host root disk is itself persistent (no separate mount).
# SILK_ALLOW_NONMOUNT_PERSIST=1

# مسار قاعدة التحليلات (اختياري) — وجّهه لقرص دائم في الإنتاج (Railway volume
# على /data مثلًا؛ لا تركّب القرص فوق data/ لأنه يحوي ملفات CSV مرجعية).
# Analyses DB path override — point at a persistent disk in production
# (e.g. a Railway volume at /data; never mount over data/, it holds seed CSVs).
# SILK_DB=/data/silk.db

# مخزن الحقائق الموحّد (تدفقات تجارية/مؤشرات) — نفس القرص. Fact-store DB path.
# SILK_STORE_DB=/data/silk_store.db

# مجلد ذاكرة طلبات GET على القرص (silk_cache) — نفس القرص. Request-cache dir.
# SILK_CACHE_DIR=/data/cache

# ── التحديث الدوري · SCHEDULED REFRESH ────────────────────────────────────────
# ساعات بين تشغيلات تحديث المخزن (silk_collectors.refresh: مؤشرات البنك الدولي
# + تسخين مسبق لتدفقات Comtrade — رموز HS الأخيرة × أسواق الأولوية، بميزانية
# صلبة وbackoff). غير مضبوط/0 = معطّل. يعمل خيطاً داخل خدمة الويب (قرص Railway
# يُركَّب على خدمة واحدة — لا خدمة cron منفصلة).
# Hours between refresh runs; unset/0 = off. Runs in-process (volume is
# single-service on Railway).
# SILK_REFRESH_HOURS=24

# تأخير أول تشغيلة بعد الإقلاع بالثواني (افتراضي 120). Initial delay seconds.
# SILK_REFRESH_INITIAL_S=120

# احتياطي ميزانية Comtrade يُترك للطلبات الحية أثناء التسخين (افتراضي 150).
# Comtrade-budget reserve kept for live traffic during pre-warm.
# SILK_REFRESH_BUDGET_RESERVE=150

# أسواق الأولوية للتسخين المسبق (ISO3 بفواصل؛ الافتراضي أول 12 من قائمة المنصّة).
# Priority markets for pre-warming (comma ISO3; default: platform top 12).
# SILK_PRIORITY_MARKETS=ARE,KWT,QAT,OMN,BHR,EGY,JOR

# ── سياسة الحداثة · FRESHNESS / TTL POLICY ────────────────────────────────────
# نافذة الحداثة بالأيام لكل نوع: داخلها تُخدم القيمة من المخزن فوراً (مجاناً)؛
# خارجها تُخدم فوراً معلَّمة «stale» ويُطلَق تحديث بالخلفية (stale-while-
# revalidate). Freshness windows per data type (serve fast, refresh behind).
# SILK_FRESH_TRADE_DAYS=90
# SILK_FRESH_INDICATOR_DAYS=30
# SILK_FRESH_PRICE_DAYS=7

# تعطيل تحديث الخلفية عند العتاقة (للتشخيص فقط) — SWR kill switch.
# SILK_SWR=0

# مباعدة نداءات HTTP لكل مضيف (مللي ثانية) — النافذة العامة، وكومتريد له
# نافذة أوسع خاصة (بلاغ حي: 429 متكرر — حد كومتريد ~نداء/ثانية، والبعثات
# الاثنتا عشرة المتوازية تتشاركه). Per-host min gap; Comtrade gets its own.
# SILK_HTTP_MIN_GAP_MS=250
# SILK_COMTRADE_MIN_GAP_MS=1100
# SILK_HTTP_RETRIES=3

# مهلة الاتصال لكل مصدر (ثانية) — WS4: البنك الدولي أبطأ عادةً فيأخذ نافذةً
# أوسع من كومتريد؛ غير المعروف يبقى على القديم (30). Per-source HTTP timeout.
# SILK_WB_TIMEOUT_S=45
# SILK_COMTRADE_TIMEOUT_S=30
# SILK_HTTP_TIMEOUT_S=30

# قاطع الدائرة لكل مضيف (WS4) — بعد N فشلٍ 429/5xx متتالٍ (THRESHOLD)، نداءات
# المضيف اللاحقة تفشل بسرعة (بلا حلقة إعادة تعلّق الـfan-out) طوال فترة التهدئة
# (COOLDOWN_S)، ثم تُسمح محاولةٌ استكشافية واحدة (نصف-مفتوح): **فترة التهدئة نفسها
# هي فاصل المحاولة الاستكشافية** — probe مسموحٌ مرّةً كلّ نافذة تهدئة. النجاح
# يغلق الدائرة فوراً. تحذير: عتبةٌ منخفضةٌ جداً عبر ~١٥٠ نداء fan-out تحوّل 429
# العابر إلى فجواتٍ معلنة — أبقِ العتبة كافيةً (الافتراض 5) والتهدئة قصيرةً (60ث).
# Consecutive-failure breaker; cooldown doubles as the half-open probe interval.
# SILK_CIRCUIT_THRESHOLD=5
# SILK_CIRCUIT_COOLDOWN_S=60

# تعطيل FAOSTAT صراحة (فجوة معلنة بلا أي محاولة جلب) — بلاغ حي: 401 متكرر؛
# بلا هذا العلم، أول 401/403 يفعّل قاطع دارة تلقائياً لبقية عمر العملية.
# Kill switch; without it, the first 401/403 auto-disables for the process.
# SILK_DISABLE_FAOSTAT=1

# مهلات نداءات كلود (ثوانٍ) — القياسية للبعثات، والموسّعة للمحلل الشامل
# وكاتب التقرير (مدخلاهما نتائج البعثات الاثنتي عشرة كاملة).
# SILK_AI_TIMEOUT_S=60
# SILK_AI_LONG_TIMEOUT_S=300

# إعادة محاولة نداء كلود على الحالات العابرة فقط — 429 (تجاوز حصّة/معدّل) و529
# (ازدحام Anthropic). بلاغ حي (كاتب التقرير): نداء الكاتب الثقيل في ذيل التشغيلة
# كان يفشل من أول رفض عابر (بلا إعادة محاولة) فيصير report=None. كلاهما يُرفض
# قبل التوليد فكلفة الرموز صفر؛ backoff أسّي + احترام ترويسة Retry-After. غير
# العابر (400/401/مهلة/شبكة) لا يُعاد. =0 يعطّل الإعادة (سلوك ما قبل الإصلاح).
# SILK_LLM_MAX_RETRIES=2
# أساس backoff بالثواني (المحاولة n تنتظر base×2^n ما لم تُحدِّد Retry-After).
# SILK_LLM_RETRY_BASE_S=1.0

# النماذج التي تُهمَل معها معاملات المعاينة temperature/top_p/top_k (بادئات
# مفصولة بفواصل أو مسافات). الخلفية: Claude 4.7 فصاعداً أزالت الثلاثة معاً،
# فإرسال أيٍّ منها يردّ 400 ويسقط نداء التوليف/الكاتب/المراجع كاملاً (تقرير
# بلا سرد). حضور المفتاح وحده يكفي للرفض، فيُحذف ولا يُضبَط على 1.0. القرار
# لكل نموذج: silk_llm_provider._supports_sampling_params. ما زال يقبلها:
# claude-haiku-4-5-*, claude-sonnet-4-6 وما قبلها.
# ضبط المتغيّر **يحلّ محل** الافتراضية بالكامل: أضِف بادئة حين يُرقّى نموذج
# آخر (بلا نشر)، أو اضبطه فارغاً («») فلا يُستثنى نموذج. غير مضبوط =
# الافتراضية أدناه. القيمة الفعّالة والنموذج المحلول في GET /health → ai_model.
# SILK_LLM_NO_SAMPLING_PARAMS=claude-opus-4-7,claude-opus-4-8,claude-opus-5,claude-sonnet-5,claude-fable-5,claude-mythos

# CORS: أصول الواجهة المسموح لها بنداء الـ API (مفصولة بفواصل).
# الافتراضي الآن: نفس الأصل فقط (لا CORS) — الواجهة تُقدَّم من نفس الخدمة.
# للواجهة المنفصلة (Netlify) ضع دومينها؛ "*" يتطلب ضبطًا صريحًا ولا يُنصح به.
# CORS_ORIGINS=https://sage-pavlova-c221b1.netlify.app

# Google Trends (silk_trends_agent): لا مفتاح — يحتاج فقط: pip install pytrends
# Stage 2A: Trends وWITS وFAOSTAT ومرجع L1 مفعّلة دائماً بسياسة الخادم — لا تُدار
# بأعلام الواجهة. Always-on by server policy; UI flags no longer gate sources.

# Google Maps (silk_maps_agent): مجاني بحصة — مصانع/موزّعون/منافسون بالاسم وتقييماتهم.
# Free tier with quota. Real businesses + ratings by name (Places Text Search).
GOOGLE_MAPS_API_KEY=

# مكشطة خرائط قوقل (C1، silk_gmaps): عنوان **خدمة Railway ثانية** تشغّل
# gosom/google-maps-scraper (وضع خادم الويب + REST API) على الشبكة الخاصة —
# ليست حاوية بايثون هذه. اتركه فارغاً = تعطيل نظيف (لا كشط، لا أثر على /health
# أو المهام). راجع docs/DEPLOY_SCRAPER.md لخطوات النشر الدقيقة. مثال القيمة:
# http://gmaps-scraper.railway.internal:8080  (اسم مضيف داخلي خاص، لا عام).
# Second Railway service URL (private networking only, NEVER public). Empty =
# cleanly disabled. C2–C5 integration opens only after the owner confirms live.
SILK_GMAPS_SCRAPER_URL=

# Web Search (silk_websearch_agent): Serper is the default; agent_reach and tavily are opt-in alternatives.
# SEARCH_PROVIDER=agent_reach uses public Exa search; SEARCH_PROVIDER=tavily requires the key below.
# Optional fallback after primary failure or empty results; blank disables fallback (default).
SEARCH_FALLBACK_PROVIDER=
# Tavily credential for primary or fallback search; blank disables Tavily. Basic searches use account credits.
TAVILY_API_KEY=
# Free tier. Default provider Serper.dev (Google Search). Consumer/market signals.
# يُقبل أيضًا تحت الاسم SERPER_API_KEY (مرادف — SEARCH_API_KEY أعلى سلطة).
# Also accepted as SERPER_API_KEY (alias; SEARCH_API_KEY wins if both set).
SEARCH_API_KEY=

# WTO Tariff & Trade Data (silk_wto_tariff): مفتاح اشتراك **مجاني** بالتسجيل في
# apiportal.wto.org — يفعّل مصدر التعريفة الأساسي في سلسلة تراجع التعريفة
# (WTO TTD → WITS → فجوة معلنة)، ويسدّ فجوة التعريفة الثنائية المزمنة في WITS
# للأسواق الأوروبية. غائب => WTO يتدهور فورًا لفجوة معلنة صفريّة النداء، فيتولّى
# WITS كالسابق. يُقبل أيضًا تحت الاسم WTO_API_KEY. (IMF WEO مجاني بلا مفتاح.)
# Free WTO Timeseries subscription key; empty = WTO degrades cleanly, WITS serves.
WTO_TTD_API_KEY=

# أسعار السوق المحلي (silk_localprice_agent): مدفوع (SerpApi Google Shopping) —
# أسعار رفّ فعلية + مقارنة سعرك. طبقة /deepen فقط. PAID retail prices (deepen-only).
LOCALPRICE_API_KEY=

# Volza (silk_volza_agent): مدفوع — مستوردون بالاسم من بيانات بوالص الشحن.
# PAID subscription. Named importers/exporters from bills of lading.
VOLZA_API_KEY=

# explee (silk_explee_agent): مدفوع — مشترون وجهات اتصال B2B (امتثال GDPR/PDPL).
# PAID account (first ~333 lookups free). B2B buyers/contacts — legitimate outreach only.
EXPLEE_API_KEY=

# ── الذكاء الاصطناعي · OPTIONAL AI LAYER ──────────────────────────────────────
# الطبقة 3 (silk_ai_judge.py): كلود حَكَمًا ومُعِدّ تقرير فوق حقائق الوكلاء
# الموسومة فقط. P5: يعمل تلقائيًا على /analyze متى كان هذا المفتاح مضبوطًا
# **مع SILK_API_KEY** (بدون SILK_API_KEY يُحجب كل نداء كلود — حارس H2)؛
# بدونه تتدهور بأمان إلى لجنة التحكيم الحتمية. يُحتسب ضمن SILK_PAID_DAILY_CAP.
# Layer 3: Claude judge + report. P5: auto-on for /analyze when this key AND
# SILK_API_KEY are both set (H2 guard blocks it otherwise). Counted in the cap.
ANTHROPIC_API_KEY=

# ── أعلام الميزات الاختيارية · OPTIONAL FEATURE FLAGS (تدقيق v2، البند #9) ─────
# ميزتان مُطفأتان افتراضياً (السلوك بدونهما = سلوك اليوم حرفياً). فعّل بـ=1.

# تغطية العالم (Feature A): يوسّع ترتيب الأسواق لأكبر ~١٠٠ مستورد لكل رمز HS
# (فئة-١ منسّقة ٣٨ + فئة-٢ ديناميكية) من نداء كومتريد عالمي واحد — صفر نداء
# إضافي لكل دولة، صفر تلفيق (فجوات فئة-٢ معلنة). يفعّل أيضاً بوّابة «خارج
# التغطية» على /research. World-coverage two-tier ranking + out-of-coverage gate.
SILK_WORLD_MARKETS=0
# سقف الفئة-٢ (عدد أسواق التغطية الأساسية فوق الـ٣٨ المنسّقة). افتراضي ٦٢ (=١٠٠).
SILK_WORLD_TIER2_MAX=62

# استقبال المنتج من صورة (Feature B): يفعّل تبويبات الصورة/الكاميرا في الواجهة
# ونقطة POST /products/intake (نداء رؤية واحد مقيس يستخرج اسم المنتج للتأكيد
# قبل التحليل — لا اختلاق: ثقة دون العتبة => «اكتب الاسم يدوياً»). يتطلّب
# ANTHROPIC_API_KEY. Multimodal product intake (vision) — user confirms before analysis.
SILK_IMAGE_INTAKE=0
# عتبة الثقة الدنيا لقبول اسم مستخرَج من صورة (دونها => تعذّر قراءة صادق). افتراضي ٠٫٥٥.
SILK_INTAKE_MIN_CONFIDENCE=0.55

# مهلة كشط جهات اتصال المستوردين المتزامنة (POST /analyses/{id}/enrich-leads)
# بالثواني — آمنة للبروكسي افتراضياً (٢٥ث)؛ الكشط يواصل ويخزّن ذاتياً فإعادة
# الضغط تجلب ما اكتمل. Proxy-safe sync grace for lead enrichment (background self-caches).
SILK_GMAPS_ENRICH_GRACE_S=25

# البند هـ — حارس البنية الفرعية لقسم التوصيات: =1 يُضيف تحذيرات WARN غير حاجبة
# حين يخلو قسم التوصيات من خارطة ٩٠ يومًا / فرع «شرطا قلب الحكم» (للحكم المشروط).
# مطفأ افتراضيًا حتى معايرة معدّل التحذير على نثرٍ حيّ. E sub-structure guard.
SILK_E_SUBSTRUCTURE_CHECK=

# ═══════════════════════════════════════════════════════════════════════════
# منصّة سِلك متعددة المستأجرين (PR-1) · Silk multi-tenant platform (silk_platform/)
# ═══════════════════════════════════════════════════════════════════════════
# قاعدة بيانات المنصّة — مستقلّة عن data/silk.db؛ تُشتَقّ من SILK_DATA_DIR حين تُترك.
# Platform DB, separate from the market-intelligence store (derived from SILK_DATA_DIR).
SILK_PLATFORM_DB=

# سرّ توقيع الرموز وتعمية بيانات اعتماد SMTP عند التخزين — KMS/Vault في الإنتاج.
# غير مضبوط => سرّ عابر لكل عملية (تطوير فقط؛ التواقيع لا تصمد عبر إعادة التشغيل).
# Signing/field-encryption secret; unset ⇒ ephemeral per-process (dev only).
SILK_PLATFORM_SECRET=

# كلمات مرور البذر — افتراضياتها للتطوير فقط، استبدلها قبل أي نشر.
# Seed passwords — dev defaults; override before any deployment.
SILK_SEED_ADMIN_PASSWORD=
SILK_SEED_ANALYST_PASSWORD=
SILK_SEED_FACTORY_A_PASSWORD=
SILK_SEED_FACTORY_B_PASSWORD=

# كشف رمز إعادة التعيين في ردّ الـAPI — للاختبار فقط (=1). الإنتاج: غير مضبوط
# فلا يُعاد الرمز الخام أبداً (يُرسَل بالبريد في PR-5)؛ كشفه يفتح استيلاءً على
# الحساب. Test-only; unset in production (raw reset token is emailed, never returned).
SILK_PLATFORM_EXPOSE_RESET_TOKEN=

# كوكي الجلسة بعلم secure (HTTPS فقط) — اضبطه =1 في الإنتاج خلف HTTPS.
# Session cookie Secure flag; set =1 in production behind HTTPS.
SILK_PLATFORM_SECURE_COOKIES=

# إشارة إنتاج تُلزِم ضبط SILK_PLATFORM_SECRET — حارس الإقلاع يفشل بصوت عالٍ لو
# ضُبطت هذي (=1) والسرّ غائب، بدل الخدمة بسرّ عابر. (SILK_PLATFORM_SECURE_COOKIES=1
# إشارة إنتاج أيضاً.) Production signal forcing the secret; boot fails loudly if unset.
SILK_PLATFORM_REQUIRE_SECRET=

# سقف المديونية بالسنتات — أقصى ما يُسمح للرصيد أن يهبط تحت الصفر. المديونية
# تحدث من مسارين مقصودين فقط: خصم بريدٍ خرج فعلاً، وفوترة تخزين شهرية (دَينٌ
# حقيقي يجب أن يُقيَّد). ما دام الرصيد سالباً: لا إطلاق ولا إرسال حتى التمويل.
# Max overdraft (cents). While negative: launches and sends are blocked.
SILK_PLATFORM_MAX_OVERDRAFT_CENTS=

# خنق تسجيل الدخول — سقف الفشل ونافذته (ثوانٍ). الحالة في قاعدة المنصّة فهي
# مشتركة بين كل عمّال uvicorn وتصمد لإعادة النشر (لا تنفصل لكل عملية).
# Login throttle; DB-backed ⇒ shared across workers, survives restarts.
SILK_PLATFORM_LOGIN_MAX_FAILURES=
SILK_PLATFORM_LOGIN_WINDOW_S=

# عامل عمل bcrypt — **للاختبارات فقط**. الإنتاج ١٢ (المواصفة §11): غياب المتغيّر
# ⇒ ١٢، وقيمة تالفة/خارج المدى ⇒ ١٢، وحارس الإقلاع **يرفض** أقلّ من ١٢ مع أي
# إشارة إنتاج. قياس: تجزئة بعامل ١٢ ≈ ٢٧٧ms، فالحزمة تخفّضه إلى ٤ (١٣٣ث ⇒ ٣١ث).
# Test-only knob; production is 12 and cannot be weakened (default+clamp+boot guard).
SILK_PLATFORM_BCRYPT_ROUNDS=
# نظير scrypt للمسار الاحتياطي (قوّة للعدد ٢؛ غير ذلك يُتجاهَل). Default 16384.
SILK_PLATFORM_SCRYPT_N=

# ── مجدول مهام المنصّة (PR-2) · platform job scheduler ───────────────────────
# خيط داخل العملية لا خدمة cron منفصلة: وحدة تخزين Railway تُركَّب على خدمة واحدة
# فقط، فمهمّة في خدمة أخرى لن ترى قاعدة المنصّة أصلاً (نفس سبب silk_collectors).
# `1` يشغّله؛ **أي قيمة أخرى أو الغياب ⇒ لا خيط إطلاقاً** — كي لا تصفّر تشغيلةُ
# اختبار أو تطوير حصّةً ولا تكتب فاتورة تخزين في قاعدة أحد.
# المواعيد (UTC): تصفير الحصص أوّل الشهر 00:00 · فوترة التخزين أوّل الشهر 01:00 ·
# تنظيف الجلسات يومياً 02:00. المهام خاملة التكرار وتلحق ما فاتها بعد توقّف.
# Opt-in in-process scheduler; unset means no thread at all.
SILK_PLATFORM_SCHEDULER=
# فترة استطلاع الخيط بالثواني (الافتراضي ٣٠٠، وأدناها ١ كي لا تصير حلقةً بلا نوم).
SILK_PLATFORM_SCHEDULER_POLL_S=
#
# BIZ-6 (تدقيق 2026-09-01): **فوترة التخزين وحدها** خلف صمّامٍ ثانٍ. المجدول يشغّل
# ثلاث مهامّ، اثنتان منها بلا أثرٍ ماليّ (تصفير الحصص، تنظيف الجلسات) والثالثة
# تكتب **دَيناً على المستأجر**. من يريد التصفيرَ والتنظيف كان مضطرّاً لقبول
# الفاتورة معهما. `1` يكتب الفواتير؛ الغياب أو أيّ قيمةٍ أخرى ⇒ المهمّة تُتخطّى
# وتُسجَّل متخطّاةً في سجلّ المجدول (صمتٌ مقصودٌ معلَن، لا عطلٌ خفيّ).
# Storage billing needs its own opt-in: the only scheduler job that creates debt.
SILK_PLATFORM_STORAGE_BILLING=

# ── تأسيس حسابات المنصّة · platform account bootstrap ────────────────────────
# **بلاغ حيّ («ما يعمل»):** `init_db()` يُنشئ الجداول ولا شيء يبذر عند الإقلاع،
# فالإنتاج كان يُقلِع بجداولَ سليمة و**صفر مستخدمين** — فكل دخول يُرفَض بـ
# «invalid credentials» لا تُميَّز عن كلمة مرور خاطئة، فيستحيل التشخيص عن بُعد.
#
# اضبط كلمة مرور الأدمِن ⇒ يبذر الإقلاع الحسابات **مرّة واحدة** (خامل التكرار،
# لا يُعيد ضبط كلمة قائمة). لا تضبطها ⇒ **لا بذر إطلاقاً** + سطر سجلّ يشرح
# السبب وما يلزم. لا كلمة مرور مولَّدة عشوائياً تضيع، ولا كلمة تُطبَع في سجلّ.
# Opt-in: set the admin password to have boot create the accounts once.
#
# ⚠️ **السياسة مُلزِمة، والمخالفة تُسقِط البذر بكامله** (بلاغ حيّ ثانٍ: ضُبطت
# البوّابة وظلّ الدخول يُرفَض بـ«invalid credentials»). كل كلمة تُضبَط هنا يجب
# أن تحقّق **الأربعة**: ٨ أحرف على الأقل + حرف صغير + حرف كبير + رقم.
#   ✅ Silk2026admin      ❌ silk2026 (بلا كبير)   ❌ SILK2026 (بلا صغير)
#                          ❌ Silkadmin (بلا رقم)  ❌ Silk123 (٧ أحرف)
# وانتبه: `seed()` يُلبِّد الكلمات الأربع **مسبقاً** قبل إدخال أيّ صفّ، فمخالفةٌ
# في **أيٍّ** منها تمنع إنشاء الأدمِن أيضاً. السببُ يظهر مباشرةً في
# GET /health ⇒ storage.platform_ready.seed_error باسم المتغيّر المخالف
# والقاعدة المخروقة (بلا قيمته أبداً — النقطة عامّة).
# Policy is enforced: 8+ chars with lower, upper and a digit. One bad value
# blocks the whole seed; /health names the offending VARIABLE, never its value.
SILK_SEED_ADMIN_PASSWORD=
# اضبطها أيضاً لتدخل مباشرةً كحساب مصنع (owner@factory-a.local) وترى اللوحة.
# بلا ضبطها تُولَّد كلمة عشوائية غير قابلة للاستعادة — والأدمِن يستطيع إصدار
# إعادة تعيين لها عبر POST /platform/admin/users/{id}/reset.
SILK_SEED_FACTORY_A_PASSWORD=
SILK_SEED_ANALYST_PASSWORD=
SILK_SEED_FACTORY_B_PASSWORD=
#
# BIZ-12 (تدقيق 2026-09-01): حسابا المصنعَين تجريبيّان — بيانات عرضٍ لا زبائن.
# كانا يُبذَران على أيّ قاعدةٍ فارغة، فتُقلِع خدمةُ إنتاجٍ بمستأجرَين وهميّين ورصيدِ
# خزنةٍ مخترَع في دفتر الأستاذ. تحت إشارةِ إنتاج (`SILK_PLATFORM_REQUIRE_SECRET`
# أو `SILK_PLATFORM_SECURE_COOKIES`) يُتخطّيان تلقائياً؛ `1` هنا يطلبهما صراحةً
# لعرضٍ حيّ، و`0` يمنعهما حتى في التطوير.
# Demo factory tenants: auto-skipped under a production signal, forced by =1.
SILK_SEED_DEMO_FACTORIES=
#
# البُرد التي يُنشئها البذر: admin@silk.local · analyst@silk.local ·
# owner@factory-a.local · owner@factory-b.local
# والتحقّق بعد النشر: GET /health ⇒ storage.platform_ready
#   {"seeded": true, "users": 4, "accounts": 3, "seed_gate_set": true,
#    "seed_error": null}
# وقراءةُ الحالات الثلاث بلا تخمين:
#   seed_gate_set: false                  ⇒ المتغيّر غير مضبوط أصلاً.
#   seed_gate_set: true + seed_error: "…" ⇒ المتغيّر المسمّى فيه يخالف السياسة.
#   seeded: true                          ⇒ الحسابات جاهزة، ادخل.
# والشاشة على /platform.html — أمّا /platform فبادئةُ API تُحوِّل إليها.


# ── التحوّل لدراسات السوق (قرارات المالك 2026-08-17) · the market-study pivot
# طابور البريد وحملات التنقيب حُذفت نهائياً (ومعها SILK_PLATFORM_EMAIL_*).
# إطلاق دراسة مصنعٍ يشغّل silk_engine.analyze آلياً في خيط جسر المحرّك.
#
# إضافات كلود على تشغيلات دراسات المصانع — مطفأ افتراضاً (قاعدة الصمّامات):
# 0/فارغ = المسار المجاني الخالص (فجوات معلنة بلا نداءات كلود إضافية)؛
# 1 = تسمح بإضافات كلود (حكم التوليف، ثقافة المستهلك…) بنفس بوّابات
# المحاسبة القائمة. التفعيل قرار المالك — كل نقرة مصنع تصرف من رصيدك.
SILK_PLATFORM_STUDY_AI=
# وضع تشغيل دراسات المنصّة (قرار المالك 2026-08-18 — LESSONS ٧٨): فارغ/deep =
# دراسة المصنع تشغّل جسم /research العميق نفسه (١٢ بعثة + محلل + كاتب، ~١٥
# دقيقة، تتطلب ANTHROPIC_API_KEY + SILK_API_KEY وتُحاسَب من السقف اليومي —
# غيابها = رفض إطلاق معلَن engine_not_ready، لا سقوط صامتاً للوضع السريع)؛
# quick = السلوك القديم (analyze سريع بلا كلود) للتطوير/الطوارئ حصراً.
SILK_PLATFORM_STUDY_MODE=
# مقعد اختبار رُتب المتصفح حصراً — لا يُضبَط في إنتاج أبداً: يستبدل تشغيلة
# المحرّك بعيّنة موسومة تعبر مسار الحفظ الحقيقي (يضبطه LiveShapeServer).
# القيم: 1 = عيّنة تحليل سريع؛ deep = عيّنة بشكل نتيجة البحث العميق.
SILK_PLATFORM_FAKE_ENGINE=
# تأخير المقعد المحاكى بالثواني (R2، مقعد اختبار حصراً — الافتراضي ٠٫٥): يُطيل
# «قيد الإعداد» كي تمرّن رُتبةُ الخادم الحقيقي إعادةَ التشغيل والإلغاء فعلاً.
SILK_PLATFORM_FAKE_ENGINE_DELAY_S=

# ── مُشرِف تشغيلات الدراسات (R2، قرار المالك 2026-09-02) · durable study runs ─
# التشغيلة صفٌّ دائم في `study_runs` (queued → running → completed | failed |
# interrupted | cancelled): الإطلاق يُدرجه في معاملة المطالبة، والمشرف يطالب به
# حين تفرغ فتحة، ينبض له، يقاطع ما انقطعت نبضتُه (بأيّ إقلاع)، ويوسم تشغيلات
# هذه العملية «انقطعت» عند الإغلاق (uvicorn --timeout-graceful-shutdown 15).
# التعافي **صريح لا ذاتي**: الدراسة تعود مسودّةً بمؤشّر استئنافها وإشعارها،
# والمصنع يعيد الإطلاق بالقروش لا بالدولارات. The DB owns the run lifecycle.
#
# سقف التشغيلات المتزامنة في العملية (الافتراضي ٣، وأدناه ١) — ما فوقه ينتظر في
# القاعدة ويبدأ تلقائياً حين تفرغ فتحة. حدٌّ داخل العملية، لا توسّعٌ أفقي.
SILK_PLATFORM_MAX_CONCURRENT_RUNS=
# فترة النبضة بالثواني (الافتراضي ٣٠، وأدناه ١). Heartbeat interval.
SILK_PLATFORM_HEARTBEAT_S=
# عتبة اعتبار تشغيلةٍ جارية ميتة بالثواني (الافتراضي ٣٠٠، وأدناه أربعُ نبضات —
# نبضةٌ بطيئة واحدة بانتظار قفل SQLite لا تُميت تشغيلةً حيّة): صفٌّ بلا نبضة
# أطول من هذا يُوسَم «انقطع» وتُرجَع حصّته. Stale-run threshold.
SILK_PLATFORM_RUN_STALE_S=
# خيط المشرف مشغَّل افتراضياً — **مقعد اختبار**: 0 تضبطه الحزمة الهرمتية وتستدعي
# `study_runtime.tick()` صراحةً. لا يُطفأ في الإنتاج؛ وإن أُطفئ تولّت كنسةُ
# الأيتام الدورية (SILK_PLATFORM_ORPHAN_SWEEP) دورتَه كي لا تختفي المهلةُ
# القصوى والنبضة. Supervisor thread — on by default; test seam only.
SILK_PLATFORM_RUN_SUPERVISOR=

# ── الدفع العام (موجة Stripe-Dashboard — «لم أقرر، جهّزها عامة») ─────────────
# مزوّد الدفع المختار: moyasar | tap | stripe — فارغ = غير مهيأ (صفحة الدفع
# تعلن ذلك بصدق وتسجّل الطلب قيدَ تدقيق). **التكامل لم يُبنَ بعد**: حتى مع
# ضبط المزوّد ومفتاحه ترفع الوحدة ProviderNotConfigured — لا تحويل وهمي أبداً؛
# يوم يقرر المالك مزوّده يُبنى create_checkout الحقيقي لذلك الصنف وحده
# (+ ترحيل Operation.SUBSCRIPTION المؤجَّل عمداً).
SILK_PAY_PROVIDER=
# مفاتيح المزوّدات (تُقرأ يوم يُبنى التكامل — موثَّقة هنا كي لا تُخترع أسماء):
MOYASAR_SECRET_KEY=
TAP_SECRET_KEY=
STRIPE_SECRET_KEY=

# ── حدود معدل مسماة (§58) · named rate limits ───────────────────────────────
# عدّادات مستقلة عن عدّاد الدخول (كانت مستعارة منه فرفعُ تسامح الدخول يوسّع
# صامتاً ميزانيات لا علاقة له بها). الافتراضات: checkout 30 وdiag 10 وpdf 10
# طلبات لكل نافذة 300 ثانية.
# SILK_PLATFORM_CHECKOUT_MAX_REQUESTS=30
# SILK_PLATFORM_CHECKOUT_WINDOW_S=300
# BIZ-7 (تدقيق 2026-09-01): نافذةُ كشف الطلب المكرَّر بالدقائق (الافتراضي ١٤٤٠ = يوم).
# نقرةٌ مزدوجة أو إعادةُ إرسالٍ بعد شبكةٍ متردّدة كانت تكتب طلبَي اشتراكٍ متطابقين
# فيُطالَب المستأجر مرّتين. الطلبُ الثاني يُقبَل ويردّ `duplicate` كي تعرضه الواجهة،
# ولا يُكتَب في سجلّ التدقيق مرّتين. `0` يعطّل الكشف.
# SILK_PLATFORM_CHECKOUT_DEDUPE_MIN=1440
# SILK_PLATFORM_DIAG_MAX_REQUESTS=10
# SILK_PLATFORM_DIAG_WINDOW_S=300
# SILK_PLATFORM_PDF_MAX_REQUESTS=10
# SILK_PLATFORM_PDF_WINDOW_S=300
# R4 (تدقيق 2026-09-01): سطحا الرؤية (`/classify-image` و`/products/{id}/classify-image`)
# تحت عدّاد `vision|{account}` **الواحد** (٢٠ لكل ٣٠٠ث)، ورفعُ الصور تحت عدّاد
# `upload|{account}` (٣٠ لكل ٣٠٠ث) يُفحَص قبل قراءة الجسم.
# SILK_PLATFORM_VISION_MAX_REQUESTS=20
# SILK_PLATFORM_VISION_WINDOW_S=300
# SILK_PLATFORM_UPLOAD_MAX_REQUESTS=30
# SILK_PLATFORM_UPLOAD_WINDOW_S=300

# ── الأصل العام للمنصّة (PR-5) · public origin for absolute links ────────────
# يُستعمَل لبناء رابط إلغاء الاشتراك الموقَّع ورابط بريد إعادة تعيين كلمة
# المرور. الافتراض http://localhost:8000 للتطوير المحلي فقط — اضبطه في
# الإنتاج (مثلاً https://app.example.com) وإلا حملت الروابط المُرسَلة أصلاً محلياً.
SILK_PLATFORM_BASE_URL=

# ── SMTP التشغيلي: بريد إعادة تعيين كلمة المرور (PR-5) · operator transactional SMTP
# منفصل عمداً عن smtp_configs المستأجَرة المشفَّرة في القاعدة: بريد إعادة
# التعيين يصدر قبل أي جلسة مُصادَقة فلا تهيئة مستأجَر تصلح مصدراً له. غياب
# المضيف أو عنوان المرسل ⇒ لا محاولة إرسال إطلاقاً (تهيئة غير مضبوطة، لا عطل).
# فشل إرسالٍ **مع** تهيئة مضبوطة يُسجَّل تدقيقاً (`password_reset_email_failed`)
# لا في الردّ — الردّ يبقى {"ok": true} دائماً كي لا يُسرَّب وجود المستخدم.
SILK_PLATFORM_OPERATOR_SMTP_HOST=
SILK_PLATFORM_OPERATOR_SMTP_PORT=
SILK_PLATFORM_OPERATOR_SMTP_USE_TLS=
SILK_PLATFORM_OPERATOR_SMTP_USERNAME=
SILK_PLATFORM_OPERATOR_SMTP_PASSWORD=
SILK_PLATFORM_OPERATOR_SMTP_FROM_EMAIL=
SILK_PLATFORM_OPERATOR_SMTP_FROM_NAME=

# ── تخزين ملفات المنصّة (PR-8) · on-disk file storage for uploaded images ────
# قرص محلي فقط (نفس سبب SQLite: خدمة واحدة، وحدة Railway واحدة). يُشتقّ من
# SILK_DATA_DIR الموحّد ما لم يُضبَط هذا صراحةً.
SILK_PLATFORM_STORAGE_DIR=
# أقصى حجم رفع مقبول بالبايتات؛ الافتراض ١٠ ميجابايت (10485760).
SILK_PLATFORM_MAX_IMAGE_BYTES=
# R4.2 (تدقيق 2026-09-01؛ قرار المالك 2026-09-02): السقف **التجميعي** لبايتات
# صور الحساب لكل طبقة — الافتراضات basic 100 / silver 1024 / gold 5120 /
# platinum 20480 ميغابايت (`TierLimits.storage_bytes`). التجاوز ⇒ 413
# `storage_quota_exceeded` قبل أيّ بايتٍ على القرص. القيمة بالميغابايت؛ قيمةٌ
# غير صالحة أو ≤ 0 = افتراضُ الطبقة (لا انفتاحٌ صامت).
SILK_PLATFORM_STORAGE_CAP_MB_BASIC=
SILK_PLATFORM_STORAGE_CAP_MB_SILVER=
SILK_PLATFORM_STORAGE_CAP_MB_GOLD=
SILK_PLATFORM_STORAGE_CAP_MB_PLATINUM=

# ── سجلّ تشغيلات /research الجذري (R2b، تدقيق 2026-09-01) · root research runtime ──
# سقفُ تشغيلات البحث العميق المتزامنة من HTTP (تشغيلاتُ المنصّة مسقوفةٌ في
# SILK_PLATFORM_MAX_CONCURRENT_RUNS)؛ ما فوقه ⇒ 503 research_busy + Retry-After.
SILK_MAX_CONCURRENT_RESEARCH=
# فاصلُ حاصد الصفوف العالقة بالثواني — مستقلٌّ عن SILK_REFRESH_HOURS (٣٠٠؛ 0 = مطفأ،
# وهو افتراضُ الاختبارات).
SILK_ORPHAN_REAP_INTERVAL_S=

# ── وضعُ دفتر يومية SQLite (R5، تدقيق 2026-09-01) · journal mode ────────────
# `wal` افتراضاً لكل المخازن (كاتبٌ طويل لا يحجب القرّاء؛ الطبعاتُ الاحتياطية
# تبقى ملفّاً واحداً في وضع DELETE). الرجوع: `delete` — يقلب الملفّ الدائم نفسه
# عند أوّل اتصال. نظامُ ملفاتٍ لا يدعم WAL = تحذيرٌ واحد والبقاءُ على الافتراض.
SILK_SQLITE_JOURNAL_MODE=

# ── الاحتفاظ (R5، DB-16 / AUTH-20) · platform retention windows ─────────────
# تُنفَّذ في مهمّة `session_cleanup` (المجدول أو الكنّاسة الساعيّة). مطفأة (0/فارغة)
# ما عدا تنقيةَ بيانات التواصل في قيود `checkout_requested` (٩٠ يوماً افتراضاً).
# إشعاراتٌ **مقروءة** أقدم من N يوماً تُحذف؛ قيودُ تدقيقٍ غير محميّة أقدم من N يوماً
# تُحذف (قيودُ الرفض العابر والأدمِن والمال لا تُمَسّ أبداً).
SILK_PLATFORM_NOTIF_RETENTION_DAYS=
SILK_PLATFORM_AUDIT_RETENTION_DAYS=
SILK_PLATFORM_CHECKOUT_PII_DAYS=

# ── النسخ الاحتياطي (2026-08-17) · SQLite backups (silk_backup.py) ───────────
# نسخة متّسقة (sqlite3.backup) لكل المخازن القائمة إلى مجلد النسخ. يدوياً عبر
# GET /ops/backup (محروسة)، ودورياً بخيط داخل العملية عند ضبط الساعات.
# **مطفأ افتراضاً** (قاعدة صمّامات الميزات الجديدة) — التفعيل قرار مالك:
# اضبط SILK_BACKUP_HOURS=24 على الإنتاج لنسخة ليلية.
SILK_BACKUP_HOURS=
# مجلد النسخ — الافتراضي {SILK_DATA_DIR}/backups (على نفس الوحدة المركَّبة).
# R5 (DB-9/DB-10): الطبعةُ تشمل أرشيفَ صور المصانع (`platform_files.<تاريخ>.tar`)،
# وكلُّ طبعةٍ تُفحَص بـ`integrity_check` قبل اعتمادها، والاسترجاعُ شيفرةٌ مُختبَرة
# (`silk_backup.restore`). اسحب الطبعات خارج الوحدة أسبوعياً (docs/DEPLOY_RAILWAY.md §٧).
SILK_BACKUP_DIR=
# أيام الاحتفاظ قبل تدوير الطبعات القديمة — الافتراضي 7.
SILK_BACKUP_KEEP_DAYS=

# ── تنبيه الحارس الأحمر (2026-08-17) · watchdog RED push alert ───────────────
# بريد واحد عند سجلّ مراقبة أحمر (خرق عقد: تسريب/اختلاق/بوابة معطّلة) عبر
# ناقل SMTP التشغيلي أعلاه — «الحارس يرى ويُنادي» بدل انتظار فتح الصفحة.
# **مطفأ افتراضاً**: ضبطُ عنوان الاستلام هو التفعيل (قرار مالك). يتطلب
# SILK_PLATFORM_OPERATOR_SMTP_HOST/FROM_EMAIL مضبوطَين.
SILK_WATCHDOG_ALERT_EMAIL=

# ── طبقة سد الفجوات (2026-08-19) · gap recovery layer ───────────────────────
# تلاحق كل فجوة معلنة بعد اكتمال البعثات: إعادة محاولة متصاعدة، إعادة استعلام
# موسّعة لنفس المصدر، اشتقاق حسابي معلَن، نقطة نهاية بديلة لناشر معتمد، ثم بحث
# ويبي موجّه للفجوات المقيِّدة للحكم وحدها. **مطفأة افتراضاً** (قاعدة صمّامات
# الميزات الجديدة، الدرس ٧٠) — التفعيل قرار مالك: SILK_GAP_RECOVERY_ENABLED=1
SILK_GAP_RECOVERY_ENABLED=
# الموجة C (§٦ من docs/ENGINE_AUDIT.md) — **تفعيلٌ جزئيٌّ بصمّامٍ لكلّ صنف**،
# لا مفتاحَ واحدٌ يفتحها جميعاً (أمر المالك: «لا تُفعِّلها عمياء»). كلُّها تحت
# الصمّام العامّ أعلاه؛ وقيمُها الافتراضية تتبع تصنيفَ الاسترداد:
#
#   حتميّ (افتراضُه ON تحت الصمّام) — استعلامٌ من **نفس** المصدر الرسميّ الذي
#   كان سيستعمله الوكيل، بلا استنتاج. القيمةُ تُوسَم «مُستَردّ» في سطر مصدرها.
SILK_GAP_RECOVER_WGI=
SILK_GAP_RECOVER_PER_CAPITA=
SILK_GAP_RECOVER_PARTNER_SHARES=
SILK_GAP_RECOVER_TARIFF=
#   يحتاج دليلاً خارجياً موثَّقاً (افتراضُه OFF) — الموسميةُ إشارةُ اهتمامٍ
#   **بديلٌ عن** الطلب لا الطلبُ نفسه؛ والموزّعون كياناتٌ مسمّاةٌ أعلى خطرِ
#   اختلاق. لا يُفعَّلان قبل شحن وسمَيهما الصريحَين.
SILK_GAP_RECOVER_SEASONALITY=
SILK_GAP_RECOVER_DISTRIBUTORS=
#   وبحثُ الويب الحرّ **مطفأٌ بنيوياً بلا مفتاح**: مصدريّةٌ غير محدودة، وملءُ
#   فجوةٍ معلنة من نصّ ويبٍ عشوائيّ هو ما يحظره عقدُ التأسيس. مفتاحٌ يفتحه
#   خطأٌ في التصميم لا خيارُ تشغيل.
# سقوف صلبة لكل تقرير — الافتراضات 3 / 5 / 180 ثانية.
SILK_GAP_MAX_ATTEMPTS=
SILK_GAP_MAX_WEB_SEARCH=
SILK_GAP_TIMEOUT_S=

# ── صمّامات طبقات العرض (2026-08-19) · visible-layer kill switches ──────────
# كل طبقة أضافها «توجيه توليد المنصّة» وتراها العين لها مفتاح إطفاء فوري في
# الإنتاج — بلا revert وبلا إعادة نشر. **الافتراض ON** (يطابق السلوك الذي
# تحقّق منه المالك)؛ الإطفاء (0/false/off) يعيد سلوك ما قبل الموجة حرفياً.
# لغةُ المصنع تحكم لغةَ التقرير (الموجة ٠) — الإطفاء يُجبِر كلّ توليدٍ على
# العربية حرفياً كما قبل الموجة، مهما كان `accounts.language_preference`:
SILK_REPORT_LANGUAGE_ENABLED=
# تخطّي دليل الـPDF محلّياً حين يغيب LibreOffice — **بيئةُ تطويرٍ فقط**؛ في
# الإنتاج وCI غيابُ المحوّل فشلٌ لا تخطٍّ (تصحيح المالك ٥):
SILK_PDF_LOCAL_SKIP=
# قسم «أقصى سعر مصنع قابل للمنافسة» + شلال الهوامش (الموجة ٣):
SILK_ECONOMICS_SECTION_ENABLED=
# تصنيف الفجوات G1–G4 المعروض (الموجة ١) — إطفاؤه يُبقي الحدود النصّية:
SILK_GAP_REGISTER_ENABLED=
# قاعدة القرار قبل الحكم + الحجة المضادة (الموجة ٥) — الحكم نفسه لا يُمَسّ:
SILK_VERDICT_STRUCTURE_ENABLED=
# قواعد أفعال طبقات الأدلة في عقد الكاتب (الموجة ٦):
SILK_EPISTEMIC_VERBS_ENABLED=
# لغة التاجر في تقرير العميل — استبدال المصطلح بمعناه (2026-08-19):
SILK_PLAIN_LANGUAGE_ENABLED=

# ── قِدم البيانات بطبقتين (2026-08-19) · two-tier vintage ────────────────────
# تحذير ضمن الجملة فوق N سنة، ولا يُبنى استنتاج فوق M سنة. الافتراضان 3 و7؛
# SILK_STALE_DATA_YEARS القديم إن ضُبط يعمل كطبقة التحذير (توافق خلفي).
# عتبةُ تشابهِ الجمل عبر أقسام التقرير التي تُعَدّ عندها الحقيقةُ
# «مشروحةً مرّتين» (الصنف ٥، تحذيريّ فقط). الافتراض 0.55، وهو مُعايَرٌ:
# صفرُ زوجِ جملٍ يبلغ 0.45 في المدوّنات القانونية العشر. رفعُها يخفّف
# الحساسية، وخفضُها دون 0.45 يُنتِج إنذاراً كاذباً.
# SILK_XSEC_SIM=0.55
# ── الجولة الثانية من موجة عيوب التقرير: الأصناف ٦–٩ خلف رايات ─────────────
# الصنف ٦ — مخزنُ الأرقام: معرّفٌ ثابتٌ لكلّ قراءة يُحقَن في موجّه الكاتب،
# وفحصُ «قراءتان لمؤشرٍ واحد بلا تسميةِ الفرق» يصير **حاجباً**. مطفأةً:
# الموجّهُ وحكمُ البوابة كما كانا حرفياً (قرار 2026-08-19: لا حجب جديداً).
# SILK_FIGURE_STORE=1
SILK_VINTAGE_WARN_YEARS=
SILK_VINTAGE_HARD_YEARS=

# ═══════════════════════════════════════════════════════════════════════════
# ملحق التوثيق الكامل (تدقيق 2026-08-27، البند ١٨) · full env reference
# ═══════════════════════════════════════════════════════════════════════════
# **لماذا هذا القسم.** التدقيق وجد ٨٢ متغيّراً تقرؤه الشيفرة فعلاً وغائباً عن
# هذا الملف — منها **مفاتيح حوادث المال** (سقوف نداءات كلود، ميزانية كومتريد،
# سقف رموز الكاتب). المشغّل الذي لا يعرف بوجود صمّامٍ لا يستطيع إدارته: يشحّ
# عليه التقرير فلا يعرف أن سقفاً هو السبب. `tests/test_env_documented.py`
# يمنع الانجراف القادم: كل `os.environ` جديد يجب أن يُذكَر هنا.
#
# كلّها **اختيارية** — الغياب = الافتراضي المذكور، والسلوك القائم لا يتغيّر.
# All optional; absence means the documented default (today's behavior).

# ── سقوف تشغيلة /research (حوادث المال) · research run ceilings ──────────────
# سقف محاولات HTTP الفعلية لكلود عبر التحليل، بما فيها الإعادة والكاتب والمراجع.
# الافتراضي ٤٠؛ بلوغه يوقف أي إنفاق جديد وتُسلّم النتائج المتاحة بفجوات معلنة.
# SILK_RESEARCH_MAX_LLM_CALLS=40
# سقف نداءات الأدوات عبر التحليل بأكمله — الافتراضي ١٠٠.
# SILK_RESEARCH_MAX_TOOL_CALLS=100
# سقف دولاري صلب للتشغيلة الواحدة (فوق السقف اليومي) — يوقف الإنفاق داخلها.
# SILK_RESEARCH_MAX_USD=
# بوّابة الغموض قبل بدء البحث (رفض معلَن بدل دراسة على مدخلٍ ملتبس).
# SILK_RESEARCH_AMBIGUITY_GATE=
# الإيقاف المبكر حين لا تكفي الأعمدة المسجَّلة — الافتراضي مفعّل في الإنتاج.
# SILK_EARLY_HALT=1
# الحد الأدنى للأعمدة المسجَّلة قبل متابعة التشغيلة.
# SILK_MIN_SCORED_PILLARS=

# ── ميزانية كومتريد وإيقاعه · Comtrade budget ───────────────────────────────
# سقف طلبات كومتريد اليومي — الافتراضي ٤٥٠ بمفتاح و٤ بلا مفتاح (طبقة معاينة).
# COMTRADE_DAILY_BUDGET=
# ثوانٍ بين نداءات الجمع التسلسلي — الافتراضي ١٫٠.
# COMTRADE_PACE_S=1.0
# احتياطي الميزانية أثناء توسيع تغطية العالم — الافتراضي كما في الشيفرة.
# SILK_WORLD_BUDGET_RESERVE=

# ── نماذج كلود ومهلاته وسقوف رموزه · models, timeouts, token ceilings ───────
# SILK_LLM_PROVIDER=            # مزوّد الطبقة اللغوية (الافتراضي anthropic)
# SILK_AI_MODEL=                # النموذج الذكي (توليف/كاتب/مراجع)
# SILK_AI_FAST_MODEL=           # النموذج السريع (تصنيف/فلترة) — haiku افتراضاً
# SILK_MISSION_MODEL=           # نموذج البعثات الاثنتي عشرة
# SILK_MISSION_MAX_TOKENS=      # سقف إخراج البعثة الواحدة
# SILK_MISSION_TOOL_CALLS=      # ميزانية أدوات البعثة العادية (الافتراضي ٥)
# SILK_DEEP_MISSION_TOOL_CALLS=9  # ميزانية البعثات السبع العميقة
# SILK_MISSION_TIMEOUT_S=90     # مهلة المنسّق: يتخلّى عن نتيجة البعثة البطيئة
# SILK_MISSION_WALL_GRACE_S=10  # هامش السقف الجداري داخل الحلقة فوق المهلة
#                               # أعلاه (تدقيق البند ١): يوقف **الإنفاق** على
#                               # خيطٍ هُجِرت نتيجته بدل أن يواصل نداءاته.
# SILK_ANALYST_MAX_TOKENS=      # سقف إخراج المحلل الشامل
# SILK_WRITER_MAX_TOKENS=8000   # سقف إخراج الكاتب — يتضاعف عند الاقتطاع
# SILK_MAX_TOKENS_RETRIES=3     # محاولات تصعيد الكاتب عند stop_reason=max_tokens
# SILK_MAX_TOKENS_CEILING=16000 # السقف الصلب الذي لا يتجاوزه التصعيد
# SILK_WRITER_CONTINUATIONS=    # سقف أجزاء الإكمال بعد المسوّدة الجزئية
# SILK_MAX_REVIEW_CYCLES=       # دورات المراجع فوق مسوّدة الكاتب
# SILK_AI_STREAM_IDLE_S=        # مهلة خمول البثّ
# SILK_AI_STREAM_TOTAL_S=       # المهلة الكلية للبثّ
# SILK_AGENT_TIMEOUT=           # مهلة الوكيل الواحد في مسار /analyze
# SILK_ENRICH_TIMEOUT_S=        # مهلة طبقة الإثراء الواحدة

# ── استقبال المنتج من صورة · vision intake ──────────────────────────────────
# SILK_INTAKE_MODEL=
# SILK_INTAKE_MAX_TOKENS=
# SILK_INTAKE_MAX_BYTES=
# SILK_INTAKE_TIMEOUT_S=

# ── حسم رمز HS: عتبات المُصنِّف والمؤكِّد · HS resolution thresholds ─────────
# SILK_HS_CONFIDENCE_GATE=      # عتبة قبول اقتراح المصنّف
# SILK_HS_CONFIRM_GATE=         # [متروك عملياً] كان =0 يُعطّل حجبَ الرمز غير
#                               # المؤكَّد. التحقّقُ الدلاليّ صار جزءاً من
#                               # التصنيف لا بوّابةً فوقه، فلا يُعطَّل بمتغيّر.
#                               # المَخرج: hs_confirmed=true (تأكيدُ إنسان).
# SILK_HS_CONFIRM_MIN_OVERLAP=
# SILK_HS_CONFIRM_MIN_CONTAINMENT_LEN=
# SILK_HS_CANDIDATE_MIN_OVERLAP=
# SILK_HS_AUTO_MARGIN=
# SILK_HS_AUTO_MIN_OVERLAP=
# SILK_HS_FLAGGED_CONF_CAP=     # سقف الثقة لرمزٍ موسومٍ بتحفّظ
# SILK_HS_ATTR_AGREE_TOL=       # تسامح اتفاق قياسَي السمة الرقمية
# SILK_HS_ATTR_EDGE_MARGIN=     # هامش حافة النطاق قبل الحسم
# SILK_NEAR_MATCH_RATIO=        # نسبة التطابق القريب في المطابقة النصّية

# ── الترتيب والتغطية والدراسة · ranking, coverage, study defaults ───────────
# SILK_DYNAMIC_MARKETS=         # توسيع الأسواق ديناميكياً
# SILK_ORIGIN_ISO3=SAU          # بلد المنشأ الافتراضي
# SILK_STUDY_YEAR=              # سنة الدراسة الافتراضية (بدل السنة الجارية)
# SILK_DECISION_WEIGHTS=        # A (افتراضي) أو B — أوزان محرّك القرار
# SILK_REPORT_STYLE=            # أسلوب التقرير الافتراضي
# SILK_DIMENSIONS_CSV=          # مسار جدول أبعاد القياس

# ── جوجل ترندز · Google Trends resilience ───────────────────────────────────
# SILK_TRENDS_RETRIES=
# SILK_TRENDS_BACKOFF_S=
# SILK_TRENDS_BROADEN_MAX=      # مرّات توسيع الاستعلام عند إشارة ضعيفة
# SILK_TRENDS_WEAK_THRESHOLD=

# ── بحث الويب والخرائط · search & maps tuning ───────────────────────────────
# SILK_MAX_PREFERRED_SUBQUERIES=2  # سقف استعلامات site: الفرعية لكل بحث
# SILK_SEARCH_CACHE_TTL_S=0     # ذاكرة نتائج Serper بالثواني (تدقيق البند ٢٦):
#                               # ٠/غير مضبوط = مطفأة (السلوك القائم). تفعيلها
#                               # يمنع دفع ثمن استعلامٍ متطابق مرّتين عند
#                               # الاستئناف؛ **الفشل لا يُخزَّن أبداً**.
# SILK_GMAPS_TIMEOUT_SECONDS=
# SILK_GMAPS_POLL_SECONDS=
# SILK_LEAD_NAME_MAX_WORDS=     # سقف كلمات اسم الكيان المستخرَج
# SILK_LEAD_NAME_MAX_CHARS=

# ── المعقولية والاستشارات المسبقة · plausibility & pre-run advisories ───────
# SILK_PLAUSIBILITY=
# SILK_PLAUSIBILITY_ACTION=
# SILK_PRERUN_ADVISORIES=

# ── الحارس وسجلّ العمليات · watchdog & ops log ──────────────────────────────
# SILK_WATCHDOG_DB=             # مسار قاعدة الحارس (يُشتقّ من SILK_DATA_DIR)
# SILK_WATCHDOG_CAP=            # سقف صفوف الحارس المحتفظ بها
# SILK_WATCHDOG_ANALYZE_COST_BAND_USD=
# SILK_WATCHDOG_ANALYZE_DURATION_BAND_S=
# SILK_WATCHDOG_RESEARCH_COST_BAND_USD=
# SILK_WATCHDOG_RESEARCH_DURATION_BAND_S=
# SILK_OPS_LOG_DB=              # مسار سجلّ أخطاء التشغيل
# SILK_OPS_LOG_CAP=

# ── الآثار والاحتفاظ · traces & retention (تدقيق البند ١١) ──────────────────
# SILK_TRACE_DIR=               # مجلد آثار JSONL (يُشتقّ من SILK_DATA_DIR)
# كنّاس القرص الدائم — **مطفأ افتراضياً** (صمّام الميزة الجديدة). بلا ضبطٍ لا
# يُحذَف شيء إطلاقاً. لا يمسّ قاعدة التحاليل ولا مخزن الحقائق ولا دفتر
# المحاسبة أبداً — الآثار وذاكرة الطلبات وصفوف السجلّات التشخيصية فقط.
# SILK_RETENTION_DAYS=          # نافذة عامة لكل الأصناف
# SILK_TRACE_RETENTION_DAYS=30  # الافتراضي 30؛ صفر يعطل حذف الآثار. قواعد البيانات لا تُحذف.
# SILK_TRACE_MAX_BYTES=5242880  # سقف ملف الأثر الواحد؛ يحتفظ بالأحداث السابقة ويعلن بلوغ السقف
# SILK_CACHE_RETENTION_DAYS=
# SILK_OPS_RETENTION_DAYS=

# ── المنصّة: كنس الأيتام · platform orphan sweep ────────────────────────────
# SILK_PLATFORM_ORPHAN_SWEEP=   # 0 يطفئه (الحزمة الهرمتية تفعل ذلك)
# SILK_PLATFORM_ORPHAN_GRACE_S=
# SILK_PLATFORM_SWEEP_POLL_S=

# ── تشخيص وواجهات · diagnostics & surfaces ──────────────────────────────────
# صفحات التوثيق التفاعلي (تدقيق البند ٢٧): تُطفأ تلقائياً متى ضُبط
# SILK_API_KEY؛ =1 يُبقيها عامة عمداً (قرار معلَن لا صمت).
# SILK_PUBLIC_DOCS=
# نطاقات النظراء الموثوقة لترويسة X-Forwarded-For (تدقيق البند ١٣) — الافتراضي
# `*` عمداً: تضييقه يحتاج قراءة نطاق بروكسي Railway الفعلي أولاً، وتضييقٌ خاطئ
# يُعيد حادثة §58 H1 (كل الزوّار يصيرون عنوان البروكسي فينقفل خنق المعدّل).
# SILK_FORWARDED_ALLOW_IPS=*
# SILK_PDF_TEXTLAYER_FIX=      # تطبيعُ طبقةِ نصّ الـPDF العربية (افتراضياً
#   مُفعَّل؛ `0` يُطفئه). يعكس العناقيدَ العربية في خريطة `ToUnicode` مسبقاً
#   فيُلغي عكسَ المستخرِج، فيُقرأ النصُّ المنسوخ/المبحوث عنه صحيحاً. التصييرُ
#   لا يُمَسّ (مقيسٌ بكسلياً). خلافاً لقاعدة «الميزة تُشحن مطفأة»: هذا إصلاحُ
#   عطلٍ قائمٍ في مُسلَّمٍ للعميل لا ميزة، وشحنُه مطفأً يُبقي العطل.
# SILK_PDF_BRACKET_FAIL_MAX=    # سقفُ الأزواج المقلوبة هندسياً في الـPDF
#   (الافتراضي **صفر**). يعدّ الحارسُ أزواجَ أقواسٍ ثبت انقلابُها بقياس
#   مواضع المحارف على المحور x في صفوفٍ عربيةِ الأغلبية — لا محارفَ في
#   نصٍّ مستخرَج. (كان يعدّ «قوساً يتبعه فراغ» بعتبة ٣ حتى تدقيق
#   2026-08-27؛ ذاك المقياسُ كان مُعاكِسَ الإشارة: يرفض السليم ويقبل
#   المقلوب. لا ترفعه لإسكات فشلٍ — أيُّ زوجٍ مقلوبٍ عطلٌ حقيقيّ.)
#   **ترحيل:** إن كان مضبوطاً اليوم بقيمةٍ عاليةٍ للالتفاف على إنذارات
#   المقياس القديم الكاذبة — **أزِله**؛ بدلالته الجديدة يعني «تسامَحْ مع
#   كذا مستندٍ مقلوب» أي حارساً مُعطَّلاً.
# SILK_HERMETIC=                # وضع الاختبارات الهرمتي (لا يُضبَط في الإنتاج)

# ── نقاط نهاية المزوّدين المدفوعين (تُبدَّل للاختبار فقط) · paid endpoints ──
# LOCALPRICE_API_URL=
# VOLZA_API_URL=
# EXPLEE_API_URL=

# ── DATABASE_URL — قراءة توافقٍ لا مسار مدعوم ──────────────────────────────
# `silk_store.connect` يقرؤه ويتفرّع لـPostgres. **قرار المالك المستقر: SQLite
# فقط** (`docs/EXECUTION_PLAN.md`)، والفرع غير مختبَر ولا مدعوم — يُترك فارغاً
# دائماً. موثّق هنا كي لا يُضبَط بالخطأ ظنّاً أنه مسار جاهز.
# DATABASE_URL=

# ── R7 (تدقيق 2026-09-01) — صمّامات الأمن · security valves ────────────────────
# SILK_COMTRADE_KEY_IN_QUERY=   # `1` يعيد مفتاح Comtrade معاملَ استعلام (صمّامُ رجوع
#   إن رفض المزوّد الترويسة). الافتراض: ترويسة `Ocp-Apim-Subscription-Key` — لا مفتاحَ
#   في الرابط ولا في مفتاح الكاش ولا في سطور السجلّ.
# SILK_HSTS=                    # `1` يفرض Strict-Transport-Security (سنة + النطاقات
#   الفرعية)، `0` يطفئه؛ الغياب = يتبع إشارةَ إنتاج المنصّة (SECURE_COOKIES/REQUIRE_SECRET).
# SILK_HEALTH_VERBOSE=          # `1` يعيد حقول storage/version/ai_model في `/health` بلا
#   مفتاح (تشخيصٌ مؤقّت). الافتراض: تُعرَض بمفتاح X-API-Key صالح فقط حين يُضبَط SILK_API_KEY.
# SILK_RUN_AS_ROOT=             # `1` يُبقي الحاوية جذراً (docker/entrypoint.sh) — للتشخيص فقط؛
#   الافتراضُ إسقاطُ الصلاحيات إلى المستخدم `silk` (uid 10001) قبل uvicorn.
# SILK_PLATFORM_SESSION_ABSOLUTE_HOURS=   # العمرُ المطلق للجلسة بالساعات (٧٢٠ = ٣٠ يوماً)
#   فوق النافذة المنزلقة ٢٤ ساعة — جلسةٌ مسروقة لا تبقى حيّةً إلى الأبد.
# SILK_PLATFORM_LOGINEMAIL_MAX_REQUESTS=  # عدّادُ الدخول بالبريد وحده (٣٠ فشلاً)
# SILK_PLATFORM_LOGINEMAIL_WINDOW_S=      # نافذته (٩٠٠ ث) — مستقلّ عن IP فلا يُتجاوز بتدويره
# SILK_PLATFORM_CHECKOUTEMAIL_MAX_REQUESTS=   # عدّادُ طلبات الشراء بالبريد (٥)
# SILK_PLATFORM_CHECKOUTEMAIL_WINDOW_S=       # نافذته (٣٦٠٠ ث)
# SILK_PLATFORM_CHECKOUT_RETENTION_DAYS=  # حذفُ قيود checkout_requested الأقدم من النافذة
#   (٣٦٥ يوماً؛ `0` = لا حذف). تنقيةُ بيانات التواصل منها أبكر (R5: ٩٠ يوماً).
# SILK_STOP_HOOK_SUBSET=        # `1` يجعل خطّاف التوقف (.claude/hooks) يشغّل أقفالَ
#   التدقيق والدفاتر فقط بدل السويت كاملاً — أداةُ تطوير، لا أثرَ لها في الخادم.

# ── R9 (تدقيق 2026-09-01) — تشغيلُ Railway · ops valves ─────────────────────────
# `/health` مسبارُ الحياة (Railway): غيرُ متزامن، يقرأ لقطةً تُجدَّد كلَّ دورةِ حاصد
# (`SILK_ORPHAN_REAP_INTERVAL_S`) ويحمل `probe_age_s`؛ `/ready` الفحصُ الطازج المخنوق.
# SILK_MAX_BODY_BYTES=          # سقفُ حجم جسم الطلب بالبايت (٢٠ ميغابايت) — 413
#   `body_too_large` قبل قراءته (Content-Length) أو عند بلوغه (جسمٌ مقطَّع).
# SILK_PDF_MAX_CONCURRENT=      # فتحاتُ تحويل LibreOffice المتزامنة على الحاوية (٢)؛
#   الزائدُ 503 `pdf_busy` مع Retry-After.
# SILK_PDF_WAIT_S=              # انتظارُ فتحةٍ بالثواني قبل `pdf_busy` (٠ = رفضٌ فوريّ).
# SILK_TEST_SLOW_ROUTE_S=       # **اختبارٌ فقط** (رُتبة ٢): يكشف `GET /_test/slow` الذي
#   ينام هذه الثواني لإشباع مجمّع الخيوط؛ حارسُ الإقلاع يرفضه تحت أيّ إشارة إنتاج.

# ── EXT (تدقيق 2026-09-01) — الخدماتُ الخارجية · external-service valves ──────────
# SILK_HTTP_MAX_THROTTLE_WAIT_S=  # سقفُ الانتظار المتوقَّع على مباعدة المضيف (٣٠ ث) —
#   فوقه يُرفَض النداءُ فوراً (`ThrottleBacklog` = «تعذّر الجلب») بدل نومٍ داخل خيط طلب.
# SILK_ANALYZE_DEADLINE_S=        # جدارٌ زمنيّ كلّي لـ`/analyze` بالثواني؛ الطبقاتُ التي لا
#   وقتَ لها تُتخطّى وتُعلَن في `result.deadline.skipped_layers`. فارغ = بلا جدار (كما كان).
# SILK_MISSION_AUGMENT_TIMEOUT_S= # مهلةُ كلّ تعزيزٍ حتميّ بعد البعثات (٣٠ ث) — التجاوزُ يُعلَن.
# SILK_REPHRASE_MAX_SECTIONS=     # أقصى أقسام الصياغة التجارية لكلّ تقرير (٣ = ٣ نداءات كلود).
# SILK_REPHRASE_EXPECTED_USD=     # التقديرُ المسجَّل في دفتر الاستهلاك لكلّ نداء صياغة (٠٫٠١$).
# SILK_CACHE_RETENTION_DAYS=      # كنسُ ذاكرة الطلبات (`data/cache`): الافتراضُ ٣٠ يوماً منذ EXT
#   (كانت تنمو بلا حدّ)؛ `0` يطفئه. الآثارُ والعمليات تبقى مطفأةً بلا نافذةٍ صريحة.


# فرص التصدير في الداشبورد: مطفأة افتراضيًا؛ 1 يفعّل الوحدة للمصنع والأدمن.
# Export opportunities dashboard: opt in with 1; default 0 preserves existing UI.
SILK_EXPORT_OPPORTUNITIES=0
# معرّفات حسابات المصانع المسموح لها، مفصولة بفواصل؛ فارغ = جميع المصانع.
# Optional factory account IDs (not user IDs); empty allows all, invalid denies all.
# Admin metrics remain accessible to admins when the feature is enabled.
SILK_EXPORT_OPPORTUNITY_ACCOUNTS=
